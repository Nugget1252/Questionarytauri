/* ============================================================
   Study Room — Live Collaborative Study Sessions (Experimental)
   Uses PeerJS (WebRTC) for P2P voice/video/data communication.
   ============================================================ */

(function () {
  'use strict';

  /* ---------- constants ---------- */
  const PEER_JS_CDN = 'https://unpkg.com/peerjs@1.5.4/dist/peerjs.min.js';
  const ROOM_CODE_LENGTH = 6;
  const MAX_PARTICIPANTS = 8;
  const PROGRESS_SYNC_INTERVAL = 10000; // 10s

  /* ---------- state ---------- */
  let peer = null;          // PeerJS instance
  let localStream = null;   // local MediaStream
  let screenStream = null;  // screen‑share stream
  let connections = {};     // peerId → { dataConn, mediaCall, stream, info }
  let roomCode = '';
  let isHost = false;
  let nickname = '';
  let roomPassword = '';    // optional room password (empty = no password)
  let isMuted = false;
  let isCameraOff = false;
  let isScreenSharing = false;
  let studyTimer = null;
  let studySeconds = 0;
  let studyGoal = '';       // what I'm studying
  let chatMessages = [];
  let peerJSLoaded = false;
  let sessionActive = false;

  /* ---------- whiteboard state ---------- */
  let wbActive = false;       // is whiteboard panel open?
  let wbCanvas = null;        // main drawing canvas (large virtual)
  let wbCtx = null;
  let wbOverlay = null;       // overlay canvas for live preview (highlighter/block-erase)
  let wbOCtx = null;
  let wbDrawing = false;
  let wbPanning = false;      // middle-click or space+drag panning
  let wbColor = '#ffffff';
  let wbPenSize = 3;
  let wbEraserSize = 20;
  let wbHighlighterSize = 18;
  let wbTool = 'pen';         // pen | eraser | highlighter | block-erase
  let wbHistory = [];          // for undo — array of {strokes} snapshots
  let wbRedoStack = [];        // for redo
  let wbQuestions = [];        // { id, question, answer }
  let wbNextQId = 1;
  let wbBlockStart = null;     // block-erase drag start {x,y}
  let wbBlockRect = null;      // current block-erase rectangle
  let wbFullscreen = false;

  /* --- infinite canvas: pan & zoom --- */
  const WB_VIRTUAL_W = 4000;  // virtual canvas width
  const WB_VIRTUAL_H = 4000;  // virtual canvas height
  let wbZoom = 1;
  let wbPanX = 0;             // pan offset in virtual coords (top-left corner of viewport)
  let wbPanY = 0;
  let wbPanStart = null;      // {mx, my, px, py} for pan drag
  let wbSpaceDown = false;    // spacebar held for pan mode

  /* ---------- helpers ---------- */
  function genRoomCode() {
    const chars = 'ABCDEFGHJKLMNPQRSTUVWXYZ23456789';
    let code = '';
    for (let i = 0; i < ROOM_CODE_LENGTH; i++) code += chars[Math.floor(Math.random() * chars.length)];
    return code;
  }

  function fmtTime(sec) {
    const h = Math.floor(sec / 3600);
    const m = Math.floor((sec % 3600) / 60);
    const s = sec % 60;
    return h > 0
      ? `${h}:${String(m).padStart(2, '0')}:${String(s).padStart(2, '0')}`
      : `${String(m).padStart(2, '0')}:${String(s).padStart(2, '0')}`;
  }

  /* ---------- PeerJS loader ---------- */
  function loadPeerJS() {
    return new Promise((resolve, reject) => {
      if (peerJSLoaded || (window.Peer)) { peerJSLoaded = true; return resolve(); }
      const s = document.createElement('script');
      s.src = PEER_JS_CDN;
      s.onload = () => { peerJSLoaded = true; resolve(); };
      s.onerror = () => reject(new Error('Failed to load PeerJS'));
      document.head.appendChild(s);
    });
  }

  /* ================================================================
     UI RENDERING
     ================================================================ */
  function renderStudyRoom() {
    const section = document.getElementById('studyRoomSection');
    if (!section) return;

    if (sessionActive) {
      renderActiveSession();
      return;
    }

    const savedNick = localStorage.getItem('questionary-study-nickname') || '';

    section.innerHTML = `
      <div class="sr-lobby">
        <div class="sr-lobby-header">
          <h2 class="section-title">Study Room</h2>
          <span class="sr-exp-badge">experimental</span>
          <div class="sr-lobby-icon"><i class="fas fa-users"></i></div>
          <p class="sr-lobby-subtitle">Study together with friends in real‑time. Share video, voice, and track each other's progress.</p>
        </div>

        <div class="sr-lobby-cards">
          <!-- Nickname -->
          <div class="sr-lobby-card">
            <h3><i class="fas fa-user-edit"></i> Your Display Name</h3>
            <input type="text" id="srNickname" class="sr-input" placeholder="Enter your name…" maxlength="24" value="${savedNick}">
          </div>

          <!-- Create -->
          <div class="sr-lobby-card sr-card-create">
            <h3><i class="fas fa-plus-circle"></i> Create a Room</h3>
            <p>Start a new study room and share the code with friends.</p>
            <div class="sr-pw-row">
              <input type="password" id="srCreatePassword" class="sr-input" placeholder="Room password (optional)" maxlength="32" autocomplete="off">
              <button type="button" class="sr-pw-toggle" id="srCreatePwToggle" title="Show password"><i class="fas fa-eye"></i></button>
            </div>
            <button class="sr-btn sr-btn-primary" id="srCreateBtn"><i class="fas fa-door-open"></i> Create Room</button>
          </div>

          <!-- Join -->
          <div class="sr-lobby-card sr-card-join">
            <h3><i class="fas fa-sign-in-alt"></i> Join a Room</h3>
            <p>Enter the 6‑character room code to join.</p>
            <div class="sr-join-row">
              <input type="text" id="srJoinCode" class="sr-input sr-code-input" placeholder="ABC123" maxlength="${ROOM_CODE_LENGTH}" spellcheck="false" autocomplete="off">
              <button class="sr-btn sr-btn-accent" id="srJoinBtn"><i class="fas fa-sign-in-alt"></i> Join</button>
            </div>
            <div class="sr-pw-row" style="margin-top:0.5rem;">
              <input type="password" id="srJoinPassword" class="sr-input" placeholder="Room password (if required)" maxlength="32" autocomplete="off">
              <button type="button" class="sr-pw-toggle" id="srJoinPwToggle" title="Show password"><i class="fas fa-eye"></i></button>
            </div>
          </div>
        </div>

        <!-- Features overview -->
        <div class="sr-features-grid">
          <div class="sr-feature-item"><i class="fas fa-video"></i><span>Video Calls</span></div>
          <div class="sr-feature-item"><i class="fas fa-microphone"></i><span>Voice Chat</span></div>
          <div class="sr-feature-item"><i class="fas fa-desktop"></i><span>Screen Share</span></div>
          <div class="sr-feature-item"><i class="fas fa-comments"></i><span>Text Chat</span></div>
          <div class="sr-feature-item"><i class="fas fa-stopwatch"></i><span>Shared Timer</span></div>
          <div class="sr-feature-item"><i class="fas fa-tasks"></i><span>Progress Tracking</span></div>
        </div>
      </div>
    `;

    /* listeners */
    const createBtn = document.getElementById('srCreateBtn');
    const joinBtn = document.getElementById('srJoinBtn');
    const joinCodeInput = document.getElementById('srJoinCode');

    createBtn && createBtn.addEventListener('click', () => handleCreate());
    joinBtn && joinBtn.addEventListener('click', () => handleJoin());
    joinCodeInput && joinCodeInput.addEventListener('keydown', e => { if (e.key === 'Enter') handleJoin(); });

    // auto-uppercase room code
    joinCodeInput && joinCodeInput.addEventListener('input', () => {
      joinCodeInput.value = joinCodeInput.value.toUpperCase().replace(/[^A-Z0-9]/g, '');
    });

    // password visibility toggles
    setupPwToggle('srCreatePwToggle', 'srCreatePassword');
    setupPwToggle('srJoinPwToggle', 'srJoinPassword');
  }

  function setupPwToggle(btnId, inputId) {
    const btn = document.getElementById(btnId);
    const input = document.getElementById(inputId);
    if (!btn || !input) return;
    btn.addEventListener('click', () => {
      const show = input.type === 'password';
      input.type = show ? 'text' : 'password';
      btn.innerHTML = `<i class="fas fa-eye${show ? '-slash' : ''}"></i>`;
    });
  }

  /* ----- active session UI ----- */
  function renderActiveSession() {
    const section = document.getElementById('studyRoomSection');
    if (!section) return;

    const participantsList = buildParticipantsHTML();

    section.innerHTML = `
      <div class="sr-session">
        <!-- Top bar -->
        <div class="sr-session-bar">
          <div class="sr-session-bar-left">
            <span class="sr-room-code-badge" title="Click to copy room code" id="srCopyCode">
              <i class="fas fa-key"></i> ${roomCode}
            </span>
            <span class="sr-session-timer" id="srSessionTimer">${fmtTime(studySeconds)}</span>
          </div>
          <div class="sr-session-bar-right">
            <button class="sr-ctrl-btn ${isMuted ? 'sr-ctrl-off' : ''}" id="srToggleMic" title="${isMuted ? 'Unmute' : 'Mute'}">
              <i class="fas fa-${isMuted ? 'microphone-slash' : 'microphone'}"></i>
            </button>
            <button class="sr-ctrl-btn ${isCameraOff ? 'sr-ctrl-off' : ''}" id="srToggleCam" title="${isCameraOff ? 'Turn camera on' : 'Turn camera off'}">
              <i class="fas fa-${isCameraOff ? 'video-slash' : 'video'}"></i>
            </button>
            <button class="sr-ctrl-btn ${isScreenSharing ? 'sr-ctrl-active' : ''}" id="srToggleScreen" title="${isScreenSharing ? 'Stop sharing' : 'Share screen'}">
              <i class="fas fa-desktop"></i>
            </button>
            <button class="sr-ctrl-btn ${wbActive ? 'sr-ctrl-active' : ''}" id="srToggleWB" title="${wbActive ? 'Close Whiteboard' : 'Open Whiteboard'}">
              <i class="fas fa-chalkboard"></i>
            </button>
            <button class="sr-ctrl-btn sr-ctrl-danger" id="srLeaveBtn" title="Leave room">
              <i class="fas fa-phone-slash"></i>
            </button>
          </div>
        </div>

        <!-- Main layout -->
        <div class="sr-session-body">
          <!-- Video grid -->
          <div class="sr-video-area">
            <div class="sr-video-grid" id="srVideoGrid">
              <!-- local video -->
              <div class="sr-video-tile sr-video-local" id="srLocalTile">
                <video id="srLocalVideo" autoplay muted playsinline></video>
                <div class="sr-video-label">${nickname} (You)</div>
                ${isCameraOff ? '<div class="sr-video-off"><i class="fas fa-user"></i></div>' : ''}
              </div>
            </div>
          </div>

          <!-- Whiteboard (hidden by default, shown when toggled) -->
          <div class="sr-wb-panel" id="srWhiteboardPanel" style="display:none;">
            <div class="sr-wb-toolbar">
              <div class="sr-wb-tools">
                <button class="sr-wb-tool-btn active" data-tool="pen" title="Pen (${window._keybinds?.wbPen || 'P'})"><i class="fas fa-pen"></i></button>
                <button class="sr-wb-tool-btn" data-tool="highlighter" title="Highlighter (${window._keybinds?.wbHighlighter || 'H'})"><i class="fas fa-highlighter"></i></button>
                <button class="sr-wb-tool-btn" data-tool="eraser" title="Eraser (${window._keybinds?.wbEraser || 'E'})"><i class="fas fa-eraser"></i></button>
                <button class="sr-wb-tool-btn" data-tool="block-erase" title="Block Erase (drag a rectangle)"><i class="fas fa-vector-square"></i></button>
                <div class="sr-wb-sep"></div>
                <input type="color" id="srWbColor" class="sr-wb-color-pick" value="${wbColor}" title="Brush color">
                <div class="sr-wb-range-group" id="srWbPenSizeGroup">
                  <label>Size</label>
                  <input type="range" id="srWbPenSize" min="1" max="30" value="${wbPenSize}" class="sr-wb-range">
                  <span id="srWbPenSizeVal">${wbPenSize}</span>
                </div>
                <div class="sr-wb-range-group" id="srWbEraserSizeGroup" style="display:none;">
                  <label>Size</label>
                  <input type="range" id="srWbEraserSize" min="5" max="80" value="${wbEraserSize}" class="sr-wb-range">
                  <span id="srWbEraserSizeVal">${wbEraserSize}</span>
                </div>
                <div class="sr-wb-range-group" id="srWbHlSizeGroup" style="display:none;">
                  <label>Size</label>
                  <input type="range" id="srWbHlSize" min="5" max="50" value="${wbHighlighterSize}" class="sr-wb-range">
                  <span id="srWbHlSizeVal">${wbHighlighterSize}</span>
                </div>
                <div class="sr-wb-sep"></div>
                <button class="sr-wb-tool-btn" id="srWbUndo" title="Undo (Ctrl+Z)"><i class="fas fa-undo"></i></button>
                <button class="sr-wb-tool-btn" id="srWbRedo" title="Redo (Ctrl+Y)"><i class="fas fa-redo"></i></button>
                <button class="sr-wb-tool-btn" id="srWbClear" title="Clear board"><i class="fas fa-trash"></i></button>
              </div>
              <div class="sr-wb-actions">
                <div class="sr-wb-zoom-group">
                  <button class="sr-wb-tool-btn" id="srWbZoomOut" title="Zoom Out"><i class="fas fa-search-minus"></i></button>
                  <span class="sr-wb-zoom-label" id="srWbZoomLabel">100%</span>
                  <button class="sr-wb-tool-btn" id="srWbZoomIn" title="Zoom In"><i class="fas fa-search-plus"></i></button>
                  <button class="sr-wb-tool-btn" id="srWbZoomReset" title="Reset View"><i class="fas fa-compress-arrows-alt"></i></button>
                </div>
                <div class="sr-wb-sep"></div>
                <button class="sr-wb-tool-btn" id="srWbFullscreen" title="Fullscreen"><i class="fas fa-expand"></i></button>
                <button class="sr-wb-tool-btn" id="srWbDownload" title="Download as PNG"><i class="fas fa-download"></i></button>
                <button class="sr-wb-tool-btn" id="srWbSaveLib" title="Save to Library"><i class="fas fa-save"></i></button>
                <button class="sr-btn sr-btn-accent sr-btn-sm" id="srWbShareScreen"><i class="fas fa-broadcast-tower"></i> Share</button>
              </div>
            </div>
            <div class="sr-wb-body">
              <div class="sr-wb-canvas-wrap" id="srWbCanvasWrap">
                <canvas id="srWbCanvas"></canvas>
                <canvas id="srWbOverlay"></canvas>
              </div>
              <div class="sr-wb-questions">
                <div class="sr-wb-q-header">
                  <h4><i class="fas fa-clipboard-list"></i> Questions</h4>
                  <button class="sr-btn sr-btn-primary sr-btn-sm" id="srWbAddQ"><i class="fas fa-plus"></i> Add</button>
                </div>
                <div class="sr-wb-q-list" id="srWbQList"></div>
              </div>
            </div>
          </div>

          <!-- Sidebar -->
          <div class="sr-sidebar" id="srSidebar">
            <div class="sr-sidebar-tabs">
              <button class="sr-tab-btn active" data-tab="chat"><i class="fas fa-comments"></i> Chat</button>
              <button class="sr-tab-btn" data-tab="participants"><i class="fas fa-users"></i> People <span class="sr-count" id="srPeopleCount">${1 + Object.keys(connections).length}</span></button>
              <button class="sr-tab-btn" data-tab="progress"><i class="fas fa-tasks"></i> Progress</button>
            </div>

            <!-- Chat panel -->
            <div class="sr-tab-panel active" id="srTabChat">
              <div class="sr-chat-messages" id="srChatMessages"></div>
              <div class="sr-chat-input-row">
                <input type="text" id="srChatInput" class="sr-input" placeholder="Type a message…" maxlength="500">
                <button class="sr-btn sr-btn-primary sr-btn-icon" id="srChatSend"><i class="fas fa-paper-plane"></i></button>
              </div>
            </div>

            <!-- Participants panel -->
            <div class="sr-tab-panel" id="srTabParticipants">
              <div id="srParticipantsList">${participantsList}</div>
            </div>

            <!-- Progress panel -->
            <div class="sr-tab-panel" id="srTabProgress">
              <div class="sr-progress-self">
                <h4>Your study goal</h4>
                <input type="text" id="srGoalInput" class="sr-input" placeholder="What are you studying?" value="${studyGoal}" maxlength="80">
                <button class="sr-btn sr-btn-accent sr-btn-sm" id="srSetGoal">Set Goal</button>
              </div>
              <div class="sr-progress-list" id="srProgressList">
                ${buildProgressHTML()}
              </div>
            </div>
          </div>
        </div>
      </div>
    `;

    attachSessionListeners();
    renderChatMessages();
    attachLocalVideo();
    reattachRemoteVideos();
  }

  /* ---------- build helpers ---------- */
  function buildParticipantsHTML() {
    let html = `<div class="sr-participant-item">
      <div class="sr-participant-avatar"><i class="fas fa-user"></i></div>
      <div class="sr-participant-info">
        <span class="sr-participant-name">${nickname} (You)${isHost ? ' <i class="fas fa-crown sr-host-icon" title="Host"></i>' : ''}</span>
        <span class="sr-participant-status"><i class="fas fa-circle sr-status-on"></i> Connected</span>
      </div>
    </div>`;
    Object.values(connections).forEach(c => {
      const name = c.info?.nickname || 'Participant';
      html += `<div class="sr-participant-item">
        <div class="sr-participant-avatar"><i class="fas fa-user"></i></div>
        <div class="sr-participant-info">
          <span class="sr-participant-name">${name}${c.info?.isHost ? ' <i class="fas fa-crown sr-host-icon"></i>' : ''}</span>
          <span class="sr-participant-status"><i class="fas fa-circle sr-status-on"></i> Connected</span>
        </div>
      </div>`;
    });
    return html;
  }

  function buildProgressHTML() {
    let html = '';
    // self
    html += `<div class="sr-progress-item">
      <div class="sr-progress-user"><i class="fas fa-user"></i> ${nickname} (You)</div>
      <div class="sr-progress-goal">${studyGoal || '<em>No goal set</em>'}</div>
      <div class="sr-progress-time"><i class="fas fa-clock"></i> ${fmtTime(studySeconds)}</div>
    </div>`;
    Object.values(connections).forEach(c => {
      const name = c.info?.nickname || 'Participant';
      html += `<div class="sr-progress-item">
        <div class="sr-progress-user"><i class="fas fa-user"></i> ${name}</div>
        <div class="sr-progress-goal">${c.info?.goal || '<em>No goal set</em>'}</div>
        <div class="sr-progress-time"><i class="fas fa-clock"></i> ${fmtTime(c.info?.seconds || 0)}</div>
      </div>`;
    });
    return html;
  }

  /* ---------- attach listeners in session ---------- */
  function attachSessionListeners() {
    // Copy room code
    const copyCodeBtn = document.getElementById('srCopyCode');
    copyCodeBtn && copyCodeBtn.addEventListener('click', () => {
      navigator.clipboard.writeText(roomCode).then(() => {
        if (typeof showNotification === 'function') showNotification('Room code copied!', 'success');
      });
    });

    // Mic toggle
    document.getElementById('srToggleMic')?.addEventListener('click', toggleMic);
    // Camera toggle
    document.getElementById('srToggleCam')?.addEventListener('click', toggleCamera);
    // Screen share
    document.getElementById('srToggleScreen')?.addEventListener('click', toggleScreenShare);
    // Leave
    document.getElementById('srLeaveBtn')?.addEventListener('click', leaveRoom);

    // Chat
    const chatInput = document.getElementById('srChatInput');
    document.getElementById('srChatSend')?.addEventListener('click', sendChatMessage);
    chatInput?.addEventListener('keydown', e => { if (e.key === 'Enter') sendChatMessage(); });

    // Sidebar tabs
    document.querySelectorAll('.sr-tab-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        document.querySelectorAll('.sr-tab-btn').forEach(b => b.classList.remove('active'));
        document.querySelectorAll('.sr-tab-panel').forEach(p => p.classList.remove('active'));
        btn.classList.add('active');
        const panel = document.getElementById('srTab' + capitalize(btn.dataset.tab));
        if (panel) panel.classList.add('active');
      });
    });

    // Study goal
    document.getElementById('srSetGoal')?.addEventListener('click', () => {
      const input = document.getElementById('srGoalInput');
      studyGoal = input?.value.trim() || '';
      broadcastData({ type: 'progress', goal: studyGoal, seconds: studySeconds });
      updateProgressUI();
      if (typeof showNotification === 'function') showNotification('Study goal updated!', 'success');
    });

    // Whiteboard toggle
    document.getElementById('srToggleWB')?.addEventListener('click', toggleWhiteboard);

    // init whiteboard listeners if panel exists
    initWhiteboardListeners();
  }

  function capitalize(s) { return s.charAt(0).toUpperCase() + s.slice(1); }

  /* ================================================================
     MEDIA — getUserMedia, attach video elements
     ================================================================ */
  async function getLocalStream() {
    try {
      localStream = await navigator.mediaDevices.getUserMedia({
        video: true,
        audio: true
      });
    } catch (e) {
      console.warn('Study Room: camera/mic unavailable, trying audio only…', e);
      try {
        localStream = await navigator.mediaDevices.getUserMedia({ video: false, audio: true });
        isCameraOff = true;
      } catch (e2) {
        console.warn('Study Room: no media devices available, continuing without…', e2);
        localStream = null;
        isCameraOff = true;
        isMuted = true;
      }
    }
  }

  function attachLocalVideo() {
    const vid = document.getElementById('srLocalVideo');
    if (vid && localStream) {
      vid.srcObject = localStream;
    }
    // show/hide camera-off overlay
    const tile = document.getElementById('srLocalTile');
    if (tile) {
      const offDiv = tile.querySelector('.sr-video-off');
      if (isCameraOff) {
        if (!offDiv) {
          const d = document.createElement('div');
          d.className = 'sr-video-off';
          d.innerHTML = '<i class="fas fa-user"></i>';
          tile.appendChild(d);
        }
      } else if (offDiv) {
        offDiv.remove();
      }
    }
  }

  function reattachRemoteVideos() {
    const grid = document.getElementById('srVideoGrid');
    if (!grid) return;
    Object.entries(connections).forEach(([peerId, conn]) => {
      if (!conn.stream) return;
      if (document.getElementById('sr-remote-' + peerId)) return;
      addRemoteVideoTile(peerId, conn.stream, conn.info?.nickname || 'Participant');
    });
  }

  function addRemoteVideoTile(peerId, stream, name) {
    const grid = document.getElementById('srVideoGrid');
    if (!grid || document.getElementById('sr-remote-' + peerId)) return;
    const tile = document.createElement('div');
    tile.className = 'sr-video-tile';
    tile.id = 'sr-remote-' + peerId;
    tile.innerHTML = `
      <video autoplay playsinline></video>
      <div class="sr-video-label">${name}</div>
    `;
    const vid = tile.querySelector('video');
    vid.srcObject = stream;
    grid.appendChild(tile);
    updateVideoGridLayout();
  }

  function removeRemoteVideoTile(peerId) {
    const tile = document.getElementById('sr-remote-' + peerId);
    if (tile) tile.remove();
    updateVideoGridLayout();
  }

  function updateVideoGridLayout() {
    const grid = document.getElementById('srVideoGrid');
    if (!grid) return;
    const count = grid.children.length;
    grid.classList.remove('sr-grid-1', 'sr-grid-2', 'sr-grid-3', 'sr-grid-4plus');
    if (count <= 1) grid.classList.add('sr-grid-1');
    else if (count === 2) grid.classList.add('sr-grid-2');
    else if (count <= 4) grid.classList.add('sr-grid-3');
    else grid.classList.add('sr-grid-4plus');
  }

  /* ================================================================
     CONTROLS — mic, camera, screen share
     ================================================================ */
  function toggleMic() {
    if (!localStream) return;
    isMuted = !isMuted;
    localStream.getAudioTracks().forEach(t => (t.enabled = !isMuted));
    const btn = document.getElementById('srToggleMic');
    if (btn) {
      btn.classList.toggle('sr-ctrl-off', isMuted);
      btn.innerHTML = `<i class="fas fa-${isMuted ? 'microphone-slash' : 'microphone'}"></i>`;
      btn.title = isMuted ? 'Unmute' : 'Mute';
    }
  }

  function toggleCamera() {
    if (!localStream) return;
    isCameraOff = !isCameraOff;
    localStream.getVideoTracks().forEach(t => (t.enabled = !isCameraOff));
    const btn = document.getElementById('srToggleCam');
    if (btn) {
      btn.classList.toggle('sr-ctrl-off', isCameraOff);
      btn.innerHTML = `<i class="fas fa-${isCameraOff ? 'video-slash' : 'video'}"></i>`;
      btn.title = isCameraOff ? 'Turn camera on' : 'Turn camera off';
    }
    // overlay
    const tile = document.getElementById('srLocalTile');
    if (tile) {
      let offDiv = tile.querySelector('.sr-video-off');
      if (isCameraOff && !offDiv) {
        const d = document.createElement('div');
        d.className = 'sr-video-off';
        d.innerHTML = '<i class="fas fa-user"></i>';
        tile.appendChild(d);
      } else if (!isCameraOff && offDiv) {
        offDiv.remove();
      }
    }
  }

  async function toggleScreenShare() {
    if (isScreenSharing) {
      // stop share
      if (screenStream) {
        screenStream.getTracks().forEach(t => t.stop());
        screenStream = null;
      }
      isScreenSharing = false;
      // revert to camera
      if (localStream) {
        Object.values(connections).forEach(c => {
          if (c.mediaCall) {
            const sender = c.mediaCall.peerConnection?.getSenders()?.find(s => s.track?.kind === 'video');
            const camTrack = localStream.getVideoTracks()[0];
            if (sender && camTrack) sender.replaceTrack(camTrack);
          }
        });
      }
    } else {
      try {
        screenStream = await navigator.mediaDevices.getDisplayMedia({ video: true, audio: false });
        isScreenSharing = true;
        const screenTrack = screenStream.getVideoTracks()[0];
        // replace camera track in all peer connections
        Object.values(connections).forEach(c => {
          if (c.mediaCall) {
            const sender = c.mediaCall.peerConnection?.getSenders()?.find(s => s.track?.kind === 'video');
            if (sender) sender.replaceTrack(screenTrack);
          }
        });
        // when user stops from browser UI
        screenTrack.onended = () => { toggleScreenShare(); };
      } catch (e) {
        console.warn('Screen share cancelled or failed', e);
        return;
      }
    }
    const btn = document.getElementById('srToggleScreen');
    if (btn) btn.classList.toggle('sr-ctrl-active', isScreenSharing);
  }

  /* ================================================================
     CHAT
     ================================================================ */
  function sendChatMessage() {
    const input = document.getElementById('srChatInput');
    if (!input) return;
    const text = input.value.trim();
    if (!text) return;
    input.value = '';
    const msg = { sender: nickname, text, time: Date.now(), type: 'chat' };
    chatMessages.push(msg);
    broadcastData(msg);
    renderChatMessages();
    // scroll to bottom
    const container = document.getElementById('srChatMessages');
    if (container) container.scrollTop = container.scrollHeight;
  }

  function renderChatMessages() {
    const container = document.getElementById('srChatMessages');
    if (!container) return;
    if (chatMessages.length === 0) {
      container.innerHTML = '<div class="sr-chat-empty"><i class="fas fa-comments"></i><p>No messages yet</p></div>';
      return;
    }
    container.innerHTML = chatMessages.map(m => {
      const isMe = m.sender === nickname;
      const timeStr = new Date(m.time).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
      if (m.type === 'system') {
        return `<div class="sr-chat-msg sr-chat-system"><em>${m.text}</em></div>`;
      }
      return `<div class="sr-chat-msg ${isMe ? 'sr-chat-me' : 'sr-chat-other'}">
        <span class="sr-chat-sender">${m.sender}</span>
        <span class="sr-chat-text">${escapeHTML(m.text)}</span>
        <span class="sr-chat-time">${timeStr}</span>
      </div>`;
    }).join('');
    container.scrollTop = container.scrollHeight;
  }

  function escapeHTML(str) {
    const d = document.createElement('div');
    d.textContent = str;
    return d.innerHTML;
  }

  /* ================================================================
     PEER CONNECTIONS (PeerJS)
     ================================================================ */
  async function initPeer(id) {
    await loadPeerJS();
    return new Promise((resolve, reject) => {
      peer = new Peer(id, {
        debug: 1,
        config: {
          iceServers: [
            { urls: 'stun:stun.l.google.com:19302' },
            { urls: 'stun:stun1.l.google.com:19302' }
          ]
        }
      });
      peer.on('open', peerId => {
        console.log('[StudyRoom] Peer open:', peerId);
        resolve(peerId);
      });
      peer.on('error', err => {
        console.error('[StudyRoom] Peer error:', err);
        if (err.type === 'unavailable-id') {
          reject(new Error('Room code already in use. Try a different one.'));
        } else if (err.type === 'peer-unavailable') {
          handleRoomNotFound();
        } else {
          reject(err);
        }
      });
      peer.on('connection', onDataConnection);
      peer.on('call', onMediaCall);
    });
  }

  function onDataConnection(dataConn) {
    const peerId = dataConn.peer;
    dataConn.on('open', () => {
      console.log('[StudyRoom] Data connection from', peerId);
      if (!connections[peerId]) connections[peerId] = {};
      connections[peerId].dataConn = dataConn;
      // Don't send info yet if we have a password — wait for auth
      if (isHost && roomPassword) {
        // Host waits for the joiner to send 'auth' message
        connections[peerId]._awaitingAuth = true;
      } else {
        // No password — send info immediately
        dataConn.send({ type: 'auth-ok' });
        dataConn.send({ type: 'info', nickname, isHost, goal: studyGoal, seconds: studySeconds });
        if (isHost) {
          const peerList = Object.keys(connections).filter(id => id !== peerId);
          dataConn.send({ type: 'peer-list', peers: peerList });
        }
      }
    });
    dataConn.on('data', data => handleData(peerId, data));
    dataConn.on('close', () => handlePeerDisconnect(peerId));
    dataConn.on('error', () => handlePeerDisconnect(peerId));
  }

  function onMediaCall(call) {
    call.answer(localStream || undefined);
    const peerId = call.peer;
    if (!connections[peerId]) connections[peerId] = {};
    connections[peerId].mediaCall = call;
    call.on('stream', remoteStream => {
      connections[peerId].stream = remoteStream;
      const name = connections[peerId].info?.nickname || 'Participant';
      addRemoteVideoTile(peerId, remoteStream, name);
    });
    call.on('close', () => removeRemoteVideoTile(peerId));
  }

  function connectToPeer(remotePeerId) {
    if (connections[remotePeerId]?.dataConn) return; // already connected
    const dataConn = peer.connect(remotePeerId, { reliable: true });
    if (!connections[remotePeerId]) connections[remotePeerId] = {};
    connections[remotePeerId].dataConn = dataConn;

    // Timeout: if data connection doesn't open, room likely doesn't exist
    const isHostPeer = remotePeerId === 'sr-' + roomCode;
    let connOpened = false;
    let connTimer = null;
    if (isHostPeer) {
      connTimer = setTimeout(() => {
        if (!connOpened) {
          console.warn('[StudyRoom] Connection to host timed out');
          dataConn.close();
          handleRoomNotFound();
        }
      }, 8000);
    }

    dataConn.on('open', () => {
      connOpened = true;
      if (connTimer) clearTimeout(connTimer);
      // Send auth if we have a password, otherwise just send info
      dataConn.send({ type: 'auth', password: roomPassword || '' });
      dataConn.send({ type: 'info', nickname, isHost, goal: studyGoal, seconds: studySeconds });
      // initiate media call
      if (localStream) {
        const call = peer.call(remotePeerId, localStream);
        connections[remotePeerId].mediaCall = call;
        call.on('stream', remoteStream => {
          connections[remotePeerId].stream = remoteStream;
          const name = connections[remotePeerId].info?.nickname || 'Participant';
          addRemoteVideoTile(remotePeerId, remoteStream, name);
        });
        call.on('close', () => removeRemoteVideoTile(remotePeerId));
      }
    });
    dataConn.on('data', data => handleData(remotePeerId, data));
    dataConn.on('close', () => handlePeerDisconnect(remotePeerId));
    dataConn.on('error', (err) => {
      if (connTimer) clearTimeout(connTimer);
      // PeerJS error type for unreachable peer
      if (isHostPeer && !connOpened) {
        handleRoomNotFound();
      } else {
        handlePeerDisconnect(remotePeerId);
      }
    });
  }

  /* --- Room not found handler --- */
  function handleRoomNotFound() {
    hideLoading();
    // Clean up
    if (peer) { peer.destroy(); peer = null; }
    if (localStream) { localStream.getTracks().forEach(t => t.stop()); localStream = null; }
    connections = {};
    sessionActive = false;
    isHost = false;
    roomCode = '';
    roomPassword = '';
    renderStudyRoom();
    if (typeof showNotification === 'function')
      showNotification('Room not found — it may have been closed or the code is incorrect.', 'error');
  }

  /* ---------- data message handling ---------- */
  function handleData(peerId, data) {
    if (!data || typeof data !== 'object') return;
    if (!connections[peerId]) connections[peerId] = {};

    switch (data.type) {
      case 'auth':
        // Host receives auth from joiner
        if (isHost) {
          const conn = connections[peerId];
          if (roomPassword && data.password !== roomPassword) {
            // Wrong password — reject
            if (conn?.dataConn?.open) {
              conn.dataConn.send({ type: 'auth-fail', reason: 'Incorrect room password.' });
            }
            // Disconnect them after a short delay
            setTimeout(() => {
              if (conn?.dataConn) conn.dataConn.close();
              if (conn?.mediaCall) conn.mediaCall.close();
              removeRemoteVideoTile(peerId);
              delete connections[peerId];
              updateParticipantsUI();
              updatePeopleCount();
            }, 500);
          } else {
            // Correct password or no password required
            delete conn._awaitingAuth;
            if (conn?.dataConn?.open) {
              conn.dataConn.send({ type: 'auth-ok' });
              conn.dataConn.send({ type: 'info', nickname, isHost, goal: studyGoal, seconds: studySeconds });
              const peerList = Object.keys(connections).filter(id => id !== peerId);
              conn.dataConn.send({ type: 'peer-list', peers: peerList });
            }
          }
        }
        break;
      case 'auth-ok':
        // Joiner is authenticated — nothing special needed, info was already sent
        break;
      case 'auth-fail':
        // Joiner was rejected
        hideLoading();
        if (peer) { peer.destroy(); peer = null; }
        if (localStream) { localStream.getTracks().forEach(t => t.stop()); localStream = null; }
        connections = {};
        sessionActive = false;
        isHost = false;
        roomCode = '';
        roomPassword = '';
        renderStudyRoom();
        if (typeof showNotification === 'function')
          showNotification(data.reason || 'Authentication failed.', 'error');
        break;
      case 'room-closed':
        // Host closed the room — everyone must leave
        addSystemMessage('The host has closed the room.');
        setTimeout(() => forceLeaveRoom(), 1500);
        break;
      case 'info':
        connections[peerId].info = { nickname: data.nickname, isHost: data.isHost, goal: data.goal || '', seconds: data.seconds || 0 };
        updateParticipantsUI();
        updateProgressUI();
        // update video tile label
        const tile = document.getElementById('sr-remote-' + peerId);
        if (tile) {
          const label = tile.querySelector('.sr-video-label');
          if (label) label.textContent = data.nickname;
        }
        // system message
        addSystemMessage(`${data.nickname} joined the room`);
        break;
      case 'chat':
        chatMessages.push({ sender: data.sender, text: data.text, time: data.time, type: 'chat' });
        renderChatMessages();
        break;
      case 'progress':
        if (connections[peerId].info) {
          connections[peerId].info.goal = data.goal || '';
          connections[peerId].info.seconds = data.seconds || 0;
        }
        updateProgressUI();
        break;
      case 'peer-list':
        // connect to other peers the host told us about
        if (Array.isArray(data.peers)) {
          data.peers.forEach(pid => {
            if (pid !== peer.id && !connections[pid]?.dataConn) {
              connectToPeer(pid);
            }
          });
        }
        break;
      case 'leave':
        addSystemMessage(`${connections[peerId]?.info?.nickname || 'A participant'} left the room`);
        handlePeerDisconnect(peerId);
        break;
      case 'system':
        addSystemMessage(data.text);
        break;
      case 'wb-stroke':
        replayStroke(data.points, data.color, data.size, data.tool, data.alpha);
        break;
      case 'wb-clear':
        clearCanvasLocal();
        break;
      case 'wb-block-erase':
        replayBlockErase(data.rect);
        break;
      case 'wb-questions':
        wbQuestions = data.questions || [];
        wbNextQId = data.nextId || wbQuestions.length + 1;
        renderQuestionsUI();
        break;
    }
  }

  function addSystemMessage(text) {
    chatMessages.push({ sender: '', text, time: Date.now(), type: 'system' });
    renderChatMessages();
  }

  function handlePeerDisconnect(peerId) {
    const conn = connections[peerId];
    if (conn?.mediaCall) conn.mediaCall.close();
    if (conn?.dataConn) conn.dataConn.close();
    removeRemoteVideoTile(peerId);
    delete connections[peerId];
    updateParticipantsUI();
    updateProgressUI();
    updatePeopleCount();

    // If we are a non-host and the host (or all peers) disconnected, the room is gone
    if (!isHost && sessionActive && Object.keys(connections).length === 0) {
      addSystemMessage('All participants have left — the room has been closed.');
      setTimeout(() => forceLeaveRoom(), 1500);
    }
  }

  function broadcastData(data) {
    Object.values(connections).forEach(c => {
      if (c.dataConn && c.dataConn.open) {
        try { c.dataConn.send(data); } catch (e) { /* ignore */ }
      }
    });
  }

  /* ---------- UI updates ---------- */
  function updateParticipantsUI() {
    const list = document.getElementById('srParticipantsList');
    if (list) list.innerHTML = buildParticipantsHTML();
    updatePeopleCount();
  }

  function updateProgressUI() {
    const list = document.getElementById('srProgressList');
    if (list) list.innerHTML = buildProgressHTML();
  }

  function updatePeopleCount() {
    const badge = document.getElementById('srPeopleCount');
    if (badge) badge.textContent = 1 + Object.keys(connections).length;
  }

  /* ================================================================
     WebRTC AVAILABILITY CHECK
     Most Linux distros compile WebKitGTK WITHOUT WebRTC JS support
     (-DENABLE_WEB_RTC=OFF).  The settings API exists as a stub but
     RTCPeerConnection is never exposed to JavaScript.
     When WebRTC is unavailable we offer to open the Study Room in
     the user's default browser (Firefox/Chrome have full WebRTC).
     ================================================================ */
  function hasWebRTC() {
    return !!(window.RTCPeerConnection || window.webkitRTCPeerConnection || window.mozRTCPeerConnection);
  }

  function checkWebRTCSupport() {
    if (hasWebRTC()) return true;

    const isLinux = navigator.userAgent.includes('Linux');
    if (isLinux) {
      showWebRTCUnavailableOverlay();
    } else {
      if (typeof showNotification === 'function')
        showNotification('Your browser/webview does not support WebRTC.', 'error');
    }
    return false;
  }

  /** Show a friendly overlay explaining the limitation and offering
   *  to open the Study Room in the system browser. */
  function showWebRTCUnavailableOverlay() {
    const section = document.getElementById('studyRoomSection');
    if (!section) return;

    // Find the lobby element and append the notice
    let lobby = section.querySelector('.sr-lobby');
    if (!lobby) return;

    // Remove any existing notice
    const existing = lobby.querySelector('.sr-webrtc-notice');
    if (existing) existing.remove();

    const notice = document.createElement('div');
    notice.className = 'sr-webrtc-notice';
    notice.innerHTML = `
      <div style="background: var(--surface-2, #1e1e2e); border: 1px solid var(--accent, #7b68ee); border-radius: 12px; padding: 1.5rem; margin-top: 1rem; text-align: center;">
        <div style="font-size: 2rem; margin-bottom: 0.5rem;"><i class="fas fa-info-circle" style="color: var(--accent, #7b68ee);"></i></div>
        <h3 style="margin: 0 0 0.5rem 0; color: var(--text, #e0e0e0);">WebRTC Not Available</h3>
        <p style="color: var(--text-secondary, #aaa); margin: 0 0 1rem 0; font-size: 0.9rem; line-height: 1.5;">
          The Study Room requires WebRTC, which is not available in this app's webview on Linux.<br>
          You can use the Study Room by opening it in your browser (Firefox, Chrome, or Brave).
        </p>
        <button id="srOpenInBrowser" class="sr-btn sr-btn-primary" style="margin-right: 0.5rem;">
          <i class="fas fa-external-link-alt"></i> Open in Browser
        </button>
        <p style="color: var(--text-secondary, #666); margin: 1rem 0 0 0; font-size: 0.75rem;">
          This is a Linux WebKitGTK limitation, not a bug in Questionary.
        </p>
      </div>
    `;
    lobby.appendChild(notice);

    const openBtn = document.getElementById('srOpenInBrowser');
    if (openBtn) {
      openBtn.addEventListener('click', () => openStudyRoomInBrowser());
    }
  }

  /** Open a lightweight Study Room page in the default browser. */
  async function openStudyRoomInBrowser() {
    const url = 'https://peerjs.com/';
    try {
      // Use Tauri's opener plugin
      if (window.__TAURI__ && window.__TAURI__.opener) {
        await window.__TAURI__.opener.openUrl(url);
      } else if (window.__TAURI__ && window.__TAURI__.shell) {
        await window.__TAURI__.shell.open(url);
      } else {
        window.open(url, '_blank');
      }
      if (typeof showNotification === 'function')
        showNotification('Opening Study Room in your browser…', 'success');
    } catch (e) {
      if (typeof showNotification === 'function')
        showNotification('Could not open browser: ' + e.message, 'error');
    }
  }

  /* ================================================================
     SESSION FLOW — create / join / leave
     ================================================================ */
  async function handleCreate() {
    if (!checkWebRTCSupport()) return;
    nickname = document.getElementById('srNickname')?.value.trim() || 'Student';
    localStorage.setItem('questionary-study-nickname', nickname);
    roomCode = genRoomCode();
    roomPassword = document.getElementById('srCreatePassword')?.value || '';
    isHost = true;

    try {
      showLoading('Creating room…');
      await getLocalStream();
      await initPeer('sr-' + roomCode);
      hideLoading();
      sessionActive = true;
      startStudyTimer();
      renderActiveSession();
      updateVideoGridLayout();
      if (typeof showNotification === 'function') {
        const pwNote = roomPassword ? ' 🔒 Password protected.' : '';
        showNotification(`Room ${roomCode} created! Share this code with friends.${pwNote}`, 'success');
      }
    } catch (err) {
      hideLoading();
      if (typeof showNotification === 'function')
        showNotification('Failed to create room: ' + err.message, 'error');
    }
  }

  async function handleJoin() {
    if (!checkWebRTCSupport()) return;
    nickname = document.getElementById('srNickname')?.value.trim() || 'Student';
    localStorage.setItem('questionary-study-nickname', nickname);
    const code = document.getElementById('srJoinCode')?.value.trim().toUpperCase();
    if (!code || code.length !== ROOM_CODE_LENGTH) {
      if (typeof showNotification === 'function')
        showNotification('Please enter a valid 6‑character room code.', 'error');
      return;
    }
    roomCode = code;
    roomPassword = document.getElementById('srJoinPassword')?.value || '';
    isHost = false;

    try {
      showLoading('Joining room…');
      await getLocalStream();
      // our peer id must be different from the host
      const myId = 'sr-' + roomCode + '-' + genRoomCode();
      await initPeer(myId);
      // connect to host
      connectToPeer('sr-' + roomCode);
      hideLoading();
      sessionActive = true;
      startStudyTimer();
      renderActiveSession();
      updateVideoGridLayout();
      if (typeof showNotification === 'function')
        showNotification(`Joined room ${roomCode}!`, 'success');
    } catch (err) {
      hideLoading();
      if (typeof showNotification === 'function')
        showNotification('Failed to join room: ' + err.message, 'error');
    }
  }

  async function leaveRoom() {
    if (typeof window.showConfirm === 'function') {
      const ok = await window.showConfirm('Leave Study Room', 'Are you sure you want to leave the study session?');
      if (!ok) return;
    }
    // If host is leaving, tell everyone the room is closing
    if (isHost) {
      broadcastData({ type: 'room-closed' });
    }
    // notify peers
    broadcastData({ type: 'leave', nickname });
    // stop timer
    stopStudyTimer();
    // save session stats
    saveSessionStats();
    // cleanup media
    if (localStream) { localStream.getTracks().forEach(t => t.stop()); localStream = null; }
    if (screenStream) { screenStream.getTracks().forEach(t => t.stop()); screenStream = null; }
    // close connections
    Object.keys(connections).forEach(pid => {
      if (connections[pid].mediaCall) connections[pid].mediaCall.close();
      if (connections[pid].dataConn) connections[pid].dataConn.close();
    });
    connections = {};
    // destroy peer
    if (peer) { peer.destroy(); peer = null; }
    // reset state
    sessionActive = false;
    isHost = false;
    roomCode = '';
    roomPassword = '';
    isMuted = false;
    isCameraOff = false;
    isScreenSharing = false;
    chatMessages = [];
    studyGoal = '';
    studySeconds = 0;
    wbActive = false;
    wbCanvas = null;
    wbCtx = null;
    wbOverlay = null;
    wbOCtx = null;
    wbHistory = [];
    wbRedoStack = [];
    wbZoom = 1;
    wbPanX = 0;
    wbPanY = 0;
    wbSpaceDown = false;
    wbFullscreen = false;
    // exit fullscreen if active
    if (document.fullscreenElement) document.exitFullscreen().catch(() => {});
    // re‑render lobby
    renderStudyRoom();
    if (typeof showNotification === 'function')
      showNotification('You have left the study room.', 'info');
  }

  /** Force-leave without confirm dialog (used when host closes room or all peers leave) */
  function forceLeaveRoom() {
    broadcastData({ type: 'leave', nickname });
    stopStudyTimer();
    saveSessionStats();
    if (localStream) { localStream.getTracks().forEach(t => t.stop()); localStream = null; }
    if (screenStream) { screenStream.getTracks().forEach(t => t.stop()); screenStream = null; }
    Object.keys(connections).forEach(pid => {
      if (connections[pid]?.mediaCall) connections[pid].mediaCall.close();
      if (connections[pid]?.dataConn) connections[pid].dataConn.close();
    });
    connections = {};
    if (peer) { peer.destroy(); peer = null; }
    sessionActive = false;
    isHost = false;
    roomCode = '';
    roomPassword = '';
    isMuted = false;
    isCameraOff = false;
    isScreenSharing = false;
    chatMessages = [];
    studyGoal = '';
    studySeconds = 0;
    wbActive = false;
    wbCanvas = null;
    wbCtx = null;
    wbOverlay = null;
    wbOCtx = null;
    wbHistory = [];
    wbRedoStack = [];
    wbZoom = 1;
    wbPanX = 0;
    wbPanY = 0;
    wbSpaceDown = false;
    wbFullscreen = false;
    if (document.fullscreenElement) document.exitFullscreen().catch(() => {});
    renderStudyRoom();
    if (typeof showNotification === 'function')
      showNotification('The study room has been closed.', 'info');
  }

  /* ---------- study timer ---------- */
  function startStudyTimer() {
    studySeconds = 0;
    studyTimer = setInterval(() => {
      studySeconds++;
      const el = document.getElementById('srSessionTimer');
      if (el) el.textContent = fmtTime(studySeconds);
      // periodic progress sync
      if (studySeconds % (PROGRESS_SYNC_INTERVAL / 1000) === 0) {
        broadcastData({ type: 'progress', goal: studyGoal, seconds: studySeconds });
        updateProgressUI();
      }
    }, 1000);
  }

  function stopStudyTimer() {
    if (studyTimer) { clearInterval(studyTimer); studyTimer = null; }
  }

  /* ---------- session stats persistence ---------- */
  function saveSessionStats() {
    if (studySeconds < 30) return; // skip very short sessions
    const sessions = JSON.parse(localStorage.getItem('questionary-study-sessions') || '[]');
    sessions.push({
      date: new Date().toISOString(),
      duration: studySeconds,
      goal: studyGoal,
      participants: 1 + Object.keys(connections).length,
      roomCode
    });
    // keep last 100
    if (sessions.length > 100) sessions.splice(0, sessions.length - 100);
    localStorage.setItem('questionary-study-sessions', JSON.stringify(sessions));
  }

  /* ---------- simple loading overlay ---------- */
  function showLoading(msg) {
    let overlay = document.getElementById('srLoadingOverlay');
    if (!overlay) {
      overlay = document.createElement('div');
      overlay.id = 'srLoadingOverlay';
      overlay.className = 'sr-loading-overlay';
      document.body.appendChild(overlay);
    }
    overlay.innerHTML = `<div class="sr-loading-box"><div class="sr-spinner"></div><p>${msg || 'Loading…'}</p></div>`;
    overlay.style.display = 'flex';
  }

  function hideLoading() {
    const overlay = document.getElementById('srLoadingOverlay');
    if (overlay) overlay.style.display = 'none';
  }

  /* ================================================================
     WHITEBOARD — infinite canvas with pan, zoom, drawing tools
     ================================================================ */
  function toggleWhiteboard() {
    wbActive = !wbActive;
    const panel = document.getElementById('srWhiteboardPanel');
    const videoArea = document.querySelector('.sr-video-area');
    const btn = document.getElementById('srToggleWB');
    if (panel) panel.style.display = wbActive ? 'flex' : 'none';
    if (videoArea) videoArea.style.display = wbActive ? 'none' : 'block';
    if (btn) btn.classList.toggle('sr-ctrl-active', wbActive);
    if (wbActive) {
      setupCanvas();
      renderQuestionsUI();
    }
  }

  function setupCanvas() {
    wbCanvas = document.getElementById('srWbCanvas');
    wbOverlay = document.getElementById('srWbOverlay');
    if (!wbCanvas || !wbOverlay) return;
    wbCtx = wbCanvas.getContext('2d');
    wbOCtx = wbOverlay.getContext('2d');

    // Virtual canvas — large fixed size (the "infinite" surface)
    wbCanvas.width = WB_VIRTUAL_W;
    wbCanvas.height = WB_VIRTUAL_H;
    wbOverlay.width = WB_VIRTUAL_W;
    wbOverlay.height = WB_VIRTUAL_H;

    // Fill background
    wbCtx.fillStyle = '#1e1e2e';
    wbCtx.fillRect(0, 0, WB_VIRTUAL_W, WB_VIRTUAL_H);

    // Reset view
    wbZoom = 1;
    wbPanX = (WB_VIRTUAL_W - getWrapSize().w) / 2; // center viewport
    wbPanY = (WB_VIRTUAL_H - getWrapSize().h) / 2;
    wbHistory = [];
    wbRedoStack = [];
    saveWbSnapshot();
    applyTransform();
    updateZoomLabel();
  }

  function getWrapSize() {
    const wrap = document.getElementById('srWbCanvasWrap');
    return wrap ? { w: wrap.clientWidth, h: wrap.clientHeight } : { w: 960, h: 540 };
  }

  /* --- Apply CSS transform for pan/zoom --- */
  function applyTransform() {
    if (!wbCanvas || !wbOverlay) return;
    const tx = -wbPanX * wbZoom;
    const ty = -wbPanY * wbZoom;
    const t = `translate(${tx}px, ${ty}px) scale(${wbZoom})`;
    wbCanvas.style.transformOrigin = '0 0';
    wbCanvas.style.transform = t;
    wbOverlay.style.transformOrigin = '0 0';
    wbOverlay.style.transform = t;
  }

  function updateZoomLabel() {
    const lbl = document.getElementById('srWbZoomLabel');
    if (lbl) lbl.textContent = Math.round(wbZoom * 100) + '%';
  }

  /* --- Convert screen coords → virtual canvas coords --- */
  function canvasXY(e) {
    const wrap = document.getElementById('srWbCanvasWrap');
    if (!wrap) return { x: 0, y: 0 };
    const rect = wrap.getBoundingClientRect();
    const sx = e.clientX - rect.left;
    const sy = e.clientY - rect.top;
    return {
      x: sx / wbZoom + wbPanX,
      y: sy / wbZoom + wbPanY
    };
  }

  /* --- Zoom to a specific screen point --- */
  function zoomAtPoint(newZoom, screenX, screenY) {
    const wrap = document.getElementById('srWbCanvasWrap');
    if (!wrap) return;
    const rect = wrap.getBoundingClientRect();
    const sx = screenX - rect.left;
    const sy = screenY - rect.top;
    // Virtual point under the cursor before zoom
    const vxBefore = sx / wbZoom + wbPanX;
    const vyBefore = sy / wbZoom + wbPanY;
    wbZoom = Math.max(0.1, Math.min(5, newZoom));
    // After zoom, that same virtual point should stay under the cursor
    wbPanX = vxBefore - sx / wbZoom;
    wbPanY = vyBefore - sy / wbZoom;
    applyTransform();
    updateZoomLabel();
  }

  function zoomByDelta(delta, screenX, screenY) {
    const factor = delta > 0 ? 0.9 : 1.1;
    zoomAtPoint(wbZoom * factor, screenX, screenY);
  }

  /* --- active tool size helper --- */
  function getActiveSize() {
    if (wbTool === 'eraser') return wbEraserSize;
    if (wbTool === 'highlighter') return wbHighlighterSize;
    return wbPenSize;
  }

  /* --- tool switching --- */
  function selectWbTool(tool) {
    wbTool = tool;
    document.querySelectorAll('.sr-wb-tool-btn[data-tool]').forEach(b => {
      b.classList.toggle('active', b.dataset.tool === tool);
    });
    const penG = document.getElementById('srWbPenSizeGroup');
    const erG = document.getElementById('srWbEraserSizeGroup');
    const hlG = document.getElementById('srWbHlSizeGroup');
    if (penG) penG.style.display = (tool === 'pen') ? 'flex' : 'none';
    if (erG) erG.style.display = (tool === 'eraser' || tool === 'block-erase') ? 'flex' : 'none';
    if (hlG) hlG.style.display = (tool === 'highlighter') ? 'flex' : 'none';
    // Update cursor on the wrap container
    const wrap = document.getElementById('srWbCanvasWrap');
    if (wrap) {
      if (wbSpaceDown) wrap.style.cursor = 'grab';
      else if (tool === 'block-erase') wrap.style.cursor = 'crosshair';
      else if (tool === 'eraser') wrap.style.cursor = 'cell';
      else wrap.style.cursor = 'crosshair';
    }
  }

  /* --- canvas drawing (pointer events) --- */
  let _strokePoints = [];

  function initWhiteboardListeners() {
    const wrap = document.getElementById('srWbCanvasWrap');
    if (!wrap) return;

    // Tool buttons
    document.querySelectorAll('.sr-wb-tool-btn[data-tool]').forEach(btn => {
      btn.addEventListener('click', () => selectWbTool(btn.dataset.tool));
    });
    document.getElementById('srWbColor')?.addEventListener('input', e => { wbColor = e.target.value; });
    document.getElementById('srWbPenSize')?.addEventListener('input', e => {
      wbPenSize = parseInt(e.target.value) || 3;
      const v = document.getElementById('srWbPenSizeVal');
      if (v) v.textContent = wbPenSize;
    });
    document.getElementById('srWbEraserSize')?.addEventListener('input', e => {
      wbEraserSize = parseInt(e.target.value) || 20;
      const v = document.getElementById('srWbEraserSizeVal');
      if (v) v.textContent = wbEraserSize;
    });
    document.getElementById('srWbHlSize')?.addEventListener('input', e => {
      wbHighlighterSize = parseInt(e.target.value) || 18;
      const v = document.getElementById('srWbHlSizeVal');
      if (v) v.textContent = wbHighlighterSize;
    });
    document.getElementById('srWbUndo')?.addEventListener('click', undoCanvas);
    document.getElementById('srWbRedo')?.addEventListener('click', redoCanvas);
    document.getElementById('srWbClear')?.addEventListener('click', () => {
      clearCanvasLocal();
      broadcastData({ type: 'wb-clear' });
    });
    document.getElementById('srWbShareScreen')?.addEventListener('click', shareWhiteboardScreen);
    document.getElementById('srWbAddQ')?.addEventListener('click', addQuestion);

    // Zoom controls
    document.getElementById('srWbZoomIn')?.addEventListener('click', () => {
      const wrap2 = document.getElementById('srWbCanvasWrap');
      if (!wrap2) return;
      const r = wrap2.getBoundingClientRect();
      zoomAtPoint(wbZoom * 1.2, r.left + r.width / 2, r.top + r.height / 2);
    });
    document.getElementById('srWbZoomOut')?.addEventListener('click', () => {
      const wrap2 = document.getElementById('srWbCanvasWrap');
      if (!wrap2) return;
      const r = wrap2.getBoundingClientRect();
      zoomAtPoint(wbZoom / 1.2, r.left + r.width / 2, r.top + r.height / 2);
    });
    document.getElementById('srWbZoomReset')?.addEventListener('click', () => {
      wbZoom = 1;
      wbPanX = (WB_VIRTUAL_W - getWrapSize().w) / 2;
      wbPanY = (WB_VIRTUAL_H - getWrapSize().h) / 2;
      applyTransform();
      updateZoomLabel();
    });

    // Fullscreen
    document.getElementById('srWbFullscreen')?.addEventListener('click', toggleWbFullscreen);

    // Download
    document.getElementById('srWbDownload')?.addEventListener('click', downloadWhiteboard);

    // Save to library
    document.getElementById('srWbSaveLib')?.addEventListener('click', saveWhiteboardToLibrary);

    // Mouse wheel → zoom
    wrap.addEventListener('wheel', e => {
      e.preventDefault();
      zoomByDelta(e.deltaY, e.clientX, e.clientY);
    }, { passive: false });

    // Pointer events on the wrapper (not the canvas, so coords are relative to viewport)
    wrap.addEventListener('pointerdown', onPointerDown);
    wrap.addEventListener('pointermove', onPointerMove);
    wrap.addEventListener('pointerup', onPointerUp);
    wrap.addEventListener('pointerleave', onPointerUp);

    // Middle-click pan (prevent default context menu on middle)
    wrap.addEventListener('mousedown', e => { if (e.button === 1) e.preventDefault(); });

    // Spacebar for pan mode
    document.addEventListener('keydown', e => {
      if (e.code === 'Space' && wbActive && !wbSpaceDown) {
        const tag = document.activeElement?.tagName.toLowerCase();
        if (tag === 'input' || tag === 'textarea' || tag === 'select') return;
        e.preventDefault();
        wbSpaceDown = true;
        const w = document.getElementById('srWbCanvasWrap');
        if (w) w.style.cursor = wbPanning ? 'grabbing' : 'grab';
      }
    });
    document.addEventListener('keyup', e => {
      if (e.code === 'Space' && wbSpaceDown) {
        wbSpaceDown = false;
        selectWbTool(wbTool); // restore cursor
      }
    });

    // Listen for fullscreen change
    document.addEventListener('fullscreenchange', () => {
      wbFullscreen = !!document.fullscreenElement;
      const btn = document.getElementById('srWbFullscreen');
      if (btn) btn.innerHTML = `<i class="fas fa-${wbFullscreen ? 'compress' : 'expand'}"></i>`;
    });
  }

  function onPointerDown(e) {
    if (!wbCtx) setupCanvas();
    const { x, y } = canvasXY(e);

    // Middle click or space+left click → start panning
    if (e.button === 1 || (wbSpaceDown && e.button === 0)) {
      wbPanning = true;
      wbPanStart = { mx: e.clientX, my: e.clientY, px: wbPanX, py: wbPanY };
      const w = document.getElementById('srWbCanvasWrap');
      if (w) w.style.cursor = 'grabbing';
      e.preventDefault();
      return;
    }

    if (e.button !== 0) return;
    wbDrawing = true;
    wbRedoStack = [];

    if (wbTool === 'block-erase') {
      wbBlockStart = { x, y };
      wbBlockRect = null;
      return;
    }

    _strokePoints = [{ x, y }];

    if (wbTool === 'highlighter') {
      // Draw on overlay for live preview (avoids white dot artifacts)
      wbOCtx.clearRect(0, 0, WB_VIRTUAL_W, WB_VIRTUAL_H);
      wbOCtx.beginPath();
      wbOCtx.moveTo(x, y);
    } else {
      wbCtx.beginPath();
      wbCtx.moveTo(x, y);
    }
  }

  function onPointerMove(e) {
    // Panning
    if (wbPanning && wbPanStart) {
      const dx = (e.clientX - wbPanStart.mx) / wbZoom;
      const dy = (e.clientY - wbPanStart.my) / wbZoom;
      wbPanX = wbPanStart.px - dx;
      wbPanY = wbPanStart.py - dy;
      applyTransform();
      return;
    }

    if (!wbDrawing || !wbCtx) return;
    const { x, y } = canvasXY(e);

    // Block-erase preview on overlay
    if (wbTool === 'block-erase' && wbBlockStart) {
      const rx = Math.min(wbBlockStart.x, x);
      const ry = Math.min(wbBlockStart.y, y);
      const rw = Math.abs(x - wbBlockStart.x);
      const rh = Math.abs(y - wbBlockStart.y);
      wbBlockRect = { x: rx, y: ry, w: rw, h: rh };
      wbOCtx.clearRect(0, 0, WB_VIRTUAL_W, WB_VIRTUAL_H);
      wbOCtx.save();
      wbOCtx.strokeStyle = '#ef4444';
      wbOCtx.lineWidth = 2 / wbZoom; // keep dashes visually consistent
      wbOCtx.setLineDash([6 / wbZoom, 4 / wbZoom]);
      wbOCtx.strokeRect(rx, ry, rw, rh);
      wbOCtx.restore();
      return;
    }

    _strokePoints.push({ x, y });

    if (wbTool === 'highlighter') {
      // Redraw entire stroke on overlay each move for smooth continuous highlight
      wbOCtx.clearRect(0, 0, WB_VIRTUAL_W, WB_VIRTUAL_H);
      wbOCtx.save();
      wbOCtx.globalAlpha = 0.3;
      wbOCtx.strokeStyle = wbColor;
      wbOCtx.lineWidth = wbHighlighterSize;
      wbOCtx.lineCap = 'round';
      wbOCtx.lineJoin = 'round';
      wbOCtx.beginPath();
      wbOCtx.moveTo(_strokePoints[0].x, _strokePoints[0].y);
      for (let i = 1; i < _strokePoints.length; i++) {
        wbOCtx.lineTo(_strokePoints[i].x, _strokePoints[i].y);
      }
      wbOCtx.stroke();
      wbOCtx.restore();
    } else if (wbTool === 'eraser') {
      wbCtx.globalAlpha = 1;
      wbCtx.globalCompositeOperation = 'source-over';
      wbCtx.strokeStyle = '#1e1e2e';
      wbCtx.lineWidth = wbEraserSize;
      wbCtx.lineCap = 'round';
      wbCtx.lineJoin = 'round';
      wbCtx.lineTo(x, y);
      wbCtx.stroke();
      wbCtx.beginPath();
      wbCtx.moveTo(x, y);
    } else {
      // Pen
      wbCtx.globalAlpha = 1;
      wbCtx.globalCompositeOperation = 'source-over';
      wbCtx.strokeStyle = wbColor;
      wbCtx.lineWidth = wbPenSize;
      wbCtx.lineCap = 'round';
      wbCtx.lineJoin = 'round';
      wbCtx.lineTo(x, y);
      wbCtx.stroke();
      wbCtx.beginPath();
      wbCtx.moveTo(x, y);
    }
  }

  function onPointerUp(e) {
    // End panning
    if (wbPanning) {
      wbPanning = false;
      wbPanStart = null;
      const w = document.getElementById('srWbCanvasWrap');
      if (w) w.style.cursor = wbSpaceDown ? 'grab' : '';
      selectWbTool(wbTool); // restore cursor
      return;
    }

    if (!wbDrawing) return;
    wbDrawing = false;

    // Block-erase: fill the rectangle with bg color
    if (wbTool === 'block-erase' && wbBlockRect) {
      wbOCtx.clearRect(0, 0, WB_VIRTUAL_W, WB_VIRTUAL_H);
      wbCtx.fillStyle = '#1e1e2e';
      wbCtx.fillRect(wbBlockRect.x, wbBlockRect.y, wbBlockRect.w, wbBlockRect.h);
      saveWbSnapshot();
      broadcastData({ type: 'wb-block-erase', rect: wbBlockRect });
      wbBlockStart = null;
      wbBlockRect = null;
      return;
    }

    // Highlighter: composite overlay onto main canvas
    if (wbTool === 'highlighter' && _strokePoints.length > 1) {
      wbCtx.save();
      wbCtx.globalAlpha = 0.3;
      wbCtx.strokeStyle = wbColor;
      wbCtx.lineWidth = wbHighlighterSize;
      wbCtx.lineCap = 'round';
      wbCtx.lineJoin = 'round';
      wbCtx.beginPath();
      wbCtx.moveTo(_strokePoints[0].x, _strokePoints[0].y);
      for (let i = 1; i < _strokePoints.length; i++) {
        wbCtx.lineTo(_strokePoints[i].x, _strokePoints[i].y);
      }
      wbCtx.stroke();
      wbCtx.restore();
      wbOCtx.clearRect(0, 0, WB_VIRTUAL_W, WB_VIRTUAL_H);
    }

    wbCtx.beginPath();
    wbCtx.globalAlpha = 1;
    wbCtx.globalCompositeOperation = 'source-over';
    saveWbSnapshot();

    // Broadcast stroke
    if (_strokePoints.length > 1) {
      broadcastData({
        type: 'wb-stroke',
        points: _strokePoints,
        color: wbTool === 'eraser' ? '#1e1e2e' : wbColor,
        size: getActiveSize(),
        tool: wbTool,
        alpha: wbTool === 'highlighter' ? 0.3 : 1
      });
    }
    _strokePoints = [];
  }

  function replayStroke(points, color, size, tool, alpha) {
    if (!wbCtx || !points || points.length < 2) return;
    wbCtx.save();
    wbCtx.beginPath();
    wbCtx.strokeStyle = color;
    wbCtx.lineWidth = size;
    wbCtx.lineCap = 'round';
    wbCtx.lineJoin = 'round';
    wbCtx.globalAlpha = alpha || 1;
    wbCtx.moveTo(points[0].x, points[0].y);
    for (let i = 1; i < points.length; i++) {
      wbCtx.lineTo(points[i].x, points[i].y);
    }
    wbCtx.stroke();
    wbCtx.restore();
    wbCtx.beginPath();
    saveWbSnapshot();
  }

  function replayBlockErase(rect) {
    if (!wbCtx || !rect) return;
    wbCtx.fillStyle = '#1e1e2e';
    wbCtx.fillRect(rect.x, rect.y, rect.w, rect.h);
    saveWbSnapshot();
  }

  function saveWbSnapshot() {
    if (!wbCtx || !wbCanvas) return;
    wbHistory.push(wbCtx.getImageData(0, 0, wbCanvas.width, wbCanvas.height));
    if (wbHistory.length > 50) wbHistory.shift();
  }

  function undoCanvas() {
    if (wbHistory.length < 2 || !wbCtx) return;
    const removed = wbHistory.pop();
    wbRedoStack.push(removed);
    if (wbRedoStack.length > 50) wbRedoStack.shift();
    const prev = wbHistory[wbHistory.length - 1];
    wbCtx.putImageData(prev, 0, 0);
  }

  function redoCanvas() {
    if (wbRedoStack.length === 0 || !wbCtx) return;
    const snapshot = wbRedoStack.pop();
    wbCtx.putImageData(snapshot, 0, 0);
    wbHistory.push(snapshot);
  }

  function clearCanvasLocal() {
    if (!wbCtx || !wbCanvas) return;
    wbCtx.fillStyle = '#1e1e2e';
    wbCtx.fillRect(0, 0, wbCanvas.width, wbCanvas.height);
    wbHistory = [];
    wbRedoStack = [];
    saveWbSnapshot();
  }

  /* --- Fullscreen --- */
  function toggleWbFullscreen() {
    const panel = document.getElementById('srWhiteboardPanel');
    if (!panel) return;
    if (!document.fullscreenElement) {
      panel.requestFullscreen().catch(() => {});
    } else {
      document.exitFullscreen().catch(() => {});
    }
  }

  /* --- Download whiteboard as PNG --- */
  function downloadWhiteboard() {
    if (!wbCanvas) return;
    // Find bounding box of non-background content
    const { x, y, w, h } = getContentBounds();
    // Create a temp canvas with just the content area
    const tmp = document.createElement('canvas');
    tmp.width = w;
    tmp.height = h;
    const tCtx = tmp.getContext('2d');
    tCtx.drawImage(wbCanvas, x, y, w, h, 0, 0, w, h);
    tmp.toBlob(blob => {
      if (!blob) return;
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = `whiteboard-${Date.now()}.png`;
      a.click();
      URL.revokeObjectURL(url);
      if (typeof showNotification === 'function') showNotification('Whiteboard downloaded!', 'success');
    }, 'image/png');
  }

  /* --- Save whiteboard to library for viewing in Questionary --- */
  async function saveWhiteboardToLibrary() {
    if (!wbCanvas) return;
    let name = 'Whiteboard';
    if (typeof window.showPrompt === 'function') {
      const input = await window.showPrompt('Save Whiteboard', 'Enter a name for this whiteboard:', 'Whiteboard ' + new Date().toLocaleDateString());
      if (!input) return; // cancelled
      name = input;
    }
    const { x, y, w, h } = getContentBounds();
    const tmp = document.createElement('canvas');
    tmp.width = w;
    tmp.height = h;
    const tCtx = tmp.getContext('2d');
    tCtx.drawImage(wbCanvas, x, y, w, h, 0, 0, w, h);
    tmp.toBlob(async blob => {
      if (!blob) return;
      try {
        const id = 'wb-' + Date.now() + '-' + Math.random().toString(36).slice(2, 8);
        // Save blob to IndexedDB
        if (typeof window.savePdfBlob === 'function') {
          await window.savePdfBlob(id, blob);
        }
        // Create an entry in the documents tree under "Whiteboards" folder
        if (!window.documents) window.documents = {};
        if (!window.documents['Whiteboards']) window.documents['Whiteboards'] = {};
        const safeName = name.replace(/[<>"'&]/g, '').trim() || 'Whiteboard';
        window.documents['Whiteboards'][safeName + '.png'] = 'blob-id:' + id;
        // Persist custom documents
        if (typeof window.saveCustomDocuments === 'function') window.saveCustomDocuments();
        // Refresh tiles if on home view
        if (typeof window.renderTiles === 'function' && typeof window.getCurrentDocumentsLevel === 'function') {
          window.renderTiles(window.getCurrentDocumentsLevel());
        }
        if (typeof showNotification === 'function') showNotification(`"${safeName}" saved to Library → Whiteboards!`, 'success');
      } catch (err) {
        console.error('Failed to save whiteboard:', err);
        if (typeof showNotification === 'function') showNotification('Failed to save whiteboard', 'error');
      }
    }, 'image/png');
  }

  /* --- Get bounding box of non-background pixels --- */
  function getContentBounds() {
    if (!wbCtx || !wbCanvas) return { x: 0, y: 0, w: WB_VIRTUAL_W, h: WB_VIRTUAL_H };
    const img = wbCtx.getImageData(0, 0, wbCanvas.width, wbCanvas.height);
    const d = img.data;
    const W = wbCanvas.width;
    const H = wbCanvas.height;
    // Background color: rgb(30, 30, 46) = #1e1e2e
    let minX = W, minY = H, maxX = 0, maxY = 0;
    let found = false;
    for (let y = 0; y < H; y++) {
      for (let x = 0; x < W; x++) {
        const i = (y * W + x) * 4;
        const r = d[i], g = d[i + 1], b = d[i + 2];
        if (r !== 30 || g !== 30 || b !== 46) {
          found = true;
          if (x < minX) minX = x;
          if (x > maxX) maxX = x;
          if (y < minY) minY = y;
          if (y > maxY) maxY = y;
        }
      }
    }
    if (!found) {
      // Empty board — just export the viewport area
      const vs = getWrapSize();
      const cx = Math.max(0, Math.floor(wbPanX));
      const cy = Math.max(0, Math.floor(wbPanY));
      return { x: cx, y: cy, w: Math.min(vs.w, W - cx), h: Math.min(vs.h, H - cy) };
    }
    // Add padding
    const pad = 40;
    minX = Math.max(0, minX - pad);
    minY = Math.max(0, minY - pad);
    maxX = Math.min(W - 1, maxX + pad);
    maxY = Math.min(H - 1, maxY + pad);
    return { x: minX, y: minY, w: maxX - minX + 1, h: maxY - minY + 1 };
  }

  /* --- screen-share the whiteboard --- */
  async function shareWhiteboardScreen() {
    if (!wbCanvas) { if (typeof showNotification === 'function') showNotification('Open the whiteboard first.', 'error'); return; }
    try {
      const canvasStream = wbCanvas.captureStream(15);
      const canvasTrack = canvasStream.getVideoTracks()[0];
      Object.values(connections).forEach(c => {
        if (c.mediaCall) {
          const sender = c.mediaCall.peerConnection?.getSenders()?.find(s => s.track?.kind === 'video');
          if (sender) sender.replaceTrack(canvasTrack);
        }
      });
      isScreenSharing = true;
      const btn = document.getElementById('srToggleScreen');
      if (btn) btn.classList.add('sr-ctrl-active');
      if (typeof showNotification === 'function') showNotification('Sharing whiteboard with room!', 'success');
      canvasTrack.onended = () => {
        isScreenSharing = false;
        if (localStream) {
          const camTrack = localStream.getVideoTracks()[0];
          Object.values(connections).forEach(c => {
            if (c.mediaCall) {
              const sender = c.mediaCall.peerConnection?.getSenders()?.find(s => s.track?.kind === 'video');
              if (sender && camTrack) sender.replaceTrack(camTrack);
            }
          });
        }
        const b = document.getElementById('srToggleScreen');
        if (b) b.classList.remove('sr-ctrl-active');
      };
    } catch (err) {
      console.warn('Failed to share whiteboard', err);
      if (typeof showNotification === 'function') showNotification('Could not share whiteboard.', 'error');
    }
  }

  /* --- question / answer text areas --- */
  function addQuestion() {
    const id = wbNextQId++;
    wbQuestions.push({ id, question: '', answer: '' });
    renderQuestionsUI();
    syncQuestions();
  }

  function renderQuestionsUI() {
    const list = document.getElementById('srWbQList');
    if (!list) return;
    if (wbQuestions.length === 0) {
      list.innerHTML = '<div class="sr-wb-q-empty"><i class="fas fa-clipboard-list"></i><p>No questions yet. Click <b>Add</b> to create one.</p></div>';
      return;
    }
    list.innerHTML = wbQuestions.map((q, idx) => `
      <div class="sr-wb-q-item" data-qid="${q.id}">
        <div class="sr-wb-q-num">Q${idx + 1}
          <button class="sr-wb-q-del" data-qid="${q.id}" title="Remove"><i class="fas fa-times"></i></button>
        </div>
        <textarea class="sr-wb-q-textarea" data-field="question" data-qid="${q.id}" placeholder="Type your question…" rows="2">${escapeHTML(q.question)}</textarea>
        <textarea class="sr-wb-q-textarea sr-wb-q-answer" data-field="answer" data-qid="${q.id}" placeholder="Type your answer…" rows="3">${escapeHTML(q.answer)}</textarea>
      </div>
    `).join('');
    list.querySelectorAll('.sr-wb-q-textarea').forEach(ta => {
      ta.addEventListener('input', e => {
        const qid = parseInt(e.target.dataset.qid);
        const field = e.target.dataset.field;
        const q = wbQuestions.find(q => q.id === qid);
        if (q) { q[field] = e.target.value; syncQuestions(); }
      });
    });
    list.querySelectorAll('.sr-wb-q-del').forEach(btn => {
      btn.addEventListener('click', e => {
        const qid = parseInt(e.currentTarget.dataset.qid);
        wbQuestions = wbQuestions.filter(q => q.id !== qid);
        renderQuestionsUI();
        syncQuestions();
      });
    });
  }

  let _qSyncTimer = null;
  function syncQuestions() {
    clearTimeout(_qSyncTimer);
    _qSyncTimer = setTimeout(() => {
      broadcastData({ type: 'wb-questions', questions: wbQuestions, nextId: wbNextQId });
    }, 400);
  }

  /* ================================================================
     EXPOSE
     ================================================================ */
  window.renderStudyRoom = renderStudyRoom;
  window.leaveStudyRoom = leaveRoom;
  window.wbSelectTool = selectWbTool;
  window.wbUndo = undoCanvas;
  window.wbRedo = redoCanvas;
  window.isWhiteboardActive = () => wbActive && sessionActive;

})();
