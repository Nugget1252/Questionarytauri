/* ============================================
   QUESTIONARY MINIMAL FEATURES CSS
   ============================================ */

/* Quiz Styles */
.quiz-progress {
    height: 2px;
    background: var(--border);
    border-radius: 0;
    overflow: hidden;
    margin-bottom: 1.5rem;
}

.quiz-progress-bar {
    height: 100%;
    background: var(--text-primary);
    transition: width 0.3s ease;
}

.quiz-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1.5rem;
    font-size: 0.9rem;
    color: var(--text-secondary);
}

.quiz-score {
    font-weight: 600;
    color: var(--text-primary);
}

.quiz-question {
    text-align: center;
    padding: 1.5rem;
    background: none;
    border-radius: 0;
    margin-bottom: 1.25rem;
    border: none;
    border-bottom: 1px solid var(--border);
}

.quiz-question h3 {
    font-size: 1.1rem;
    color: var(--text-primary);
    margin: 0;
    font-weight: 600;
}

.quiz-options {
    display: grid;
    gap: 0.75rem;
}

.quiz-option {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.75rem 1rem;
    background: none;
    border: 1px solid var(--border);
    border-radius: 0;
    cursor: pointer;
    transition: all 0.1s ease;
    text-align: left;
}

.quiz-option:hover:not(:disabled) {
    background: var(--surface-hover);
}

.quiz-option.correct {
    border-color: var(--success-color);
    background: rgba(34, 197, 94, 0.05);
}

.quiz-option.wrong {
    border-color: var(--danger-color);
    background: rgba(239, 68, 68, 0.05);
}

.option-letter {
    width: 28px;
    height: 28px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--surface-hover);
    border-radius: 0;
    font-weight: 600;
    color: var(--text-secondary);
    font-size: 0.9rem;
}

.option-text {
    flex: 1;
    color: var(--text-primary);
    font-size: 0.95rem;
}

/* Quiz Results */
.quiz-results {
    text-align: center;
}

.quiz-grade {
    font-size: 3.5rem;
    font-weight: 700;
    margin: 1.5rem 0;
}

.grade-a { color: var(--success-color); }
.grade-b { color: #84cc16; }
.grade-c { color: var(--warning-color); }
.grade-d { color: #f97316; }
.grade-f { color: var(--danger-color); }

.quiz-stats {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
    margin-bottom: 2rem;
}

.quiz-stat {
    background: none;
    padding: 1rem;
    border-radius: 0;
    border: none;
    border-bottom: 1px solid var(--border);
}

.stat-value {
    display: block;
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--text-primary);
}

.stat-label {
    font-size: 0.8rem;
    color: var(--text-secondary);
    margin-top: 0.5rem;
}

/* Voice Notes */
.voice-note-item {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1rem;
    background: none;
    border: none;
    border-bottom: 1px solid var(--border);
    border-radius: 0;
    transition: all 0.1s ease;
}

.voice-note-item:hover {
    background: var(--surface-hover);
}

.voice-play {
    width: 36px;
    height: 36px;
    min-width: 36px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--surface-hover);
    color: var(--text-primary);
    border: none;
    border-radius: 0;
    cursor: pointer;
    transition: all 0.1s ease;
}

.voice-play:hover {
    opacity: 0.8;
}

.voice-info {
    flex: 1;
    display: flex;
    flex-direction: column;
}

.voice-title {
    font-weight: 600;
    color: var(--text-primary);
    font-size: 0.95rem;
}

.voice-date {
    font-size: 0.8rem;
    color: var(--text-secondary);
    margin-top: 0.25rem;
}

/* Tags */
.tag-item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.75rem 1rem;
    background: none;
    border: 1px solid var(--border);
    border-radius: 0;
    margin-bottom: 0.75rem;
    transition: all 0.1s ease;
    cursor: pointer;
}

.tag-item:hover {
    background: var(--surface-hover);
}

.tag-color {
    width: 12px;
    height: 12px;
    border-radius: 0;
    margin-right: 0.75rem;
}

.tag-name {
    flex: 1;
    font-weight: 500;
    color: var(--text-primary);
    font-size: 0.95rem;
}

.tag-count {
    font-size: 0.8rem;
    color: var(--text-secondary);
    background: none;
    padding: 0.25rem 0.5rem;
    border-radius: 0;
}

/* Reminders */
.reminder-item {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1rem;
    background: none;
    border: none;
    border-bottom: 1px solid var(--border);
    border-radius: 0;
    transition: all 0.1s ease;
}

.reminder-item:hover {
    background: var(--surface-hover);
}

.reminder-icon {
    width: 40px;
    height: 40px;
    min-width: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: none;
    color: var(--warning-color);
    border-radius: 0;
    font-size: 1.1rem;
}

.reminder-content {
    flex: 1;
}

.reminder-title {
    font-weight: 600;
    color: var(--text-primary);
    font-size: 0.95rem;
}

.reminder-time {
    font-size: 0.8rem;
    color: var(--text-secondary);
    margin-top: 0.25rem;
}

/* PDF Library */
.library-item {
    padding: 1rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    cursor: pointer;
    transition: all 0.1s ease;
    position: relative;
    min-height: 80px;
    background: none;
    border: 1px solid var(--border);
    border-radius: 0;
}

.library-item:hover {
    background: var(--surface-hover);
    border-color: var(--text-primary);
}

.library-item-icon {
    font-size: 1.5rem;
    color: var(--text-secondary);
}

.library-item-name {
    font-weight: 500;
    color: var(--text-primary);
    text-align: center;
    font-size: 0.9rem;
}

.library-item-date {
    font-size: 0.75rem;
    color: var(--text-secondary);
}

/* Bookmarks */
.bookmark-item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.75rem 1rem;
    background: none;
    border: none;
    border-bottom: 1px solid var(--border);
    border-radius: 0;
    transition: all 0.1s ease;
}

.bookmark-item:hover {
    background: var(--surface-hover);
}

.bookmark-page {
    flex: 1;
    font-weight: 500;
    color: var(--text-primary);
    font-size: 0.95rem;
}

.bookmark-delete {
    background: none;
    border: none;
    color: var(--text-secondary);
    cursor: pointer;
    padding: 0.5rem;
    transition: all 0.1s ease;
}

.bookmark-delete:hover {
    color: var(--danger-color);
}

/* Themes */
.theme-option {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1rem;
    background: none;
    border: 1px solid var(--border);
    border-radius: 0;
    cursor: pointer;
    transition: all 0.1s ease;
    margin-bottom: 0.75rem;
}

.theme-option:hover {
    background: var(--surface-hover);
}

.theme-preview {
    width: 40px;
    height: 40px;
    min-width: 40px;
    border-radius: 0;
    border: 1px solid var(--border);
}

.theme-name {
    flex: 1;
    font-weight: 500;
    color: var(--text-primary);
    font-size: 0.95rem;
}

/* Charts */
.chart-bars {
    display: flex;
    align-items: flex-end;
    justify-content: space-around;
    height: 150px;
    gap: 1rem;
    padding: 1rem;
}

.bar-container {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    height: 100%;
}

.bar-fill {
    width: 100%;
    background: var(--text-primary);
    border-radius: 0;
    transition: height 0.3s ease;
    margin-top: auto;
}

.bar-label {
    font-size: 0.7rem;
    color: var(--text-secondary);
    margin-top: 0.5rem;
}

/* Forms in modals */
.form-group.checkbox-group {
  display: flex;
  align-items: center;
  margin: 1.25rem 0;
}

.remember-me-container {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    cursor: pointer;
    padding: 0;
    border-radius: 0;
    background: none;
    border: none;
}

.remember-checkbox {
    appearance: none;
    width: 18px;
    height: 18px;
    border: 1px solid var(--border);
    border-radius: 2px;
    background: var(--surface);
    cursor: pointer;
    position: relative;
    transition: all 0.1s ease;
    flex-shrink: 0;
}

.remember-checkbox:checked {
    background: var(--text-primary);
    border-color: var(--text-primary);
}

.remember-checkbox:checked::after {
    content: '✓';
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    color: white;
    font-size: 10px;
    font-weight: bold;
}

.remember-text {
    font-weight: 500;
    color: var(--text-primary);
    font-size: 0.9rem;
}

/* Error messages */
.error-message {
    background: none;
    color: var(--danger-color);
    padding: 1rem;
    border-radius: 0;
    margin-top: 1rem;
    display: none;
    border: none;
    border-left: 3px solid var(--danger-color);
    font-size: 0.9rem;
}

/* Input hints */
.input-hint {
    position: absolute;
    right: 0.75rem;
    top: 50%;
    transform: translateY(-50%);
    font-size: 0.7rem;
    color: var(--text-secondary);
    background: var(--surface);
    padding: 0.2rem 0.3rem;
    border-radius: 0;
    border: none;
    pointer-events: none;
}

/* User badge & dropdown */
.user-badge {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.375rem 0.75rem;
    background: none;
    border-radius: 0;
    border: 1px solid var(--border);
    font-size: 0.8rem;
    white-space: nowrap;
    cursor: pointer;
    transition: all 0.1s ease;
}

.user-badge:hover {
    border-color: var(--text-primary);
}

.admin-badge {
    background: var(--warning-color);
    color: white;
    padding: 0.2rem 0.4rem;
    border-radius: 0;
    font-size: 0.65rem;
    font-weight: 600;
    text-transform: uppercase;
}

.user-dropdown-menu {
    position: absolute;
    top: calc(100% + 8px);
    right: 0;
    width: 260px;
    max-height: 70vh;
    overflow-y: auto;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 0;
    box-shadow: none;
    opacity: 0;
    visibility: hidden;
    transform: translateY(-10px);
    transition: all 0.1s ease;
    z-index: 1000;
}

.user-badge.active .user-dropdown-menu {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
}

.user-dropdown-header {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1rem;
    background: var(--surface-hover);
}

.user-dropdown-item {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.75rem 1rem;
    cursor: pointer;
    transition: all 0.1s ease;
    color: var(--text-primary);
    font-size: 0.9rem;
}

.user-dropdown-item:hover {
    background: var(--surface-hover);
}

/* Toggle switch */
.toggle-switch {
  position: relative;
  width: 44px;
  height: 24px;
  flex-shrink: 0;
}

.toggle-switch input {
  position: absolute;
  width: 100%;
  height: 100%;
  opacity: 0;
  cursor: pointer;
  z-index: 2;
  margin: 0;
}

.toggle-slider {
  position: absolute;
  cursor: pointer;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: var(--border);
  border-radius: 0;
  transition: 0.1s;
  pointer-events: none;
}

.toggle-slider:before {
  position: absolute;
  content: "";
  height: 16px;
  width: 16px;
  left: 4px;
  bottom: 4px;
  background: white;
  border-radius: 0;
  transition: 0.1s;
}

.toggle-switch input:checked + .toggle-slider {
  background: var(--text-primary);
}

.toggle-switch input:checked + .toggle-slider:before {
  transform: translateX(20px);
}
