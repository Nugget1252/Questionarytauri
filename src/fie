import os
import json

# The flat directory where your 282 beautifully renamed files are located
TARGET_DIR = os.path.expanduser("src/documents10")

# The standard list of subjects you want mapped inside your JSON structure
SUBJECT_LIST = [
    "Bengali", "Biology", "Chemistry", "Commerce", "Computer", "Economics",
    "English Language", "English Literature", "EVA", "EVS", "French",
    "Geography", "German", "Hindi", "History", "Home Science", "Math",
    "PE", "Physics", "RAI"
]

# Map your clean filename keywords back to the specific keys in your dictionary string
SUBJECT_MAP = {
    "LANGUAGE": "English Language",
    "LITERATURE": "English Literature",
    "MATHS": "Math",
    "MATH": "Math",
    "COMMERCIAL STUDIES": "Commerce",
    "COMMERCE": "Commerce",
    "COMPUTER APPLICATIONS": "Computer",
    "COMPUTER": "Computer",
    "ECONOMIC APPLICATIONS": "Economics",
    "ECONOMICS": "Economics",
    "ROBOTICS AND AI": "RAI",
    "ROBOTICS AND AI.": "RAI",
    "HISTORY AND CIVICS": "History",
    "HISTORY": "History"
}

# Translate file tags to JSON blocks (PREBOARD folder contents map to your "FT" category)
EXAM_MAP = {
    "MT_1": "MT 1",
    "MT_2": "MT 2",
    "HY": "HY",
    "PREBOARD": "FT"
}

def generate_json_index():
    if not os.path.exists(TARGET_DIR):
        print(f"❌ Cannot find directory: {TARGET_DIR}")
        return

    # Root dict to split things dynamically by Year, then Class
    nested_structure = {}

    # Scan the flat folder
    files = sorted(os.listdir(TARGET_DIR))

    for file in files:
        if not file.endswith(".pdf"):
            continue

        # Split format: "2023-24_CL_10_MT_1_SUBJECT.pdf"
        parts = file.split("_")
        if len(parts) < 5:
            continue

        year_string = parts[0] # e.g., "2023-24"
        # parts[1] is CL
        class_string = f"Class {parts[2]}" # e.g., "Class 10"
        exam_tag = parts[3] # e.g., "MT", "1", or "HY", "PREBOARD"
        
        # Re-assemble exam tags if split by underscores
        if exam_tag in ["MT", "PRE"]:
            if "MT_1" in file: exam_tag = "MT_1"
            elif "MT_2" in file: exam_tag = "MT_2"
            elif "PREBOARD" in file: exam_tag = "PREBOARD"

        # Isolate subject component string from trailing metadata/extensions
        subject_part = file.split(f"_{exam_tag}_")[1].replace(".pdf", "")
        subject_part = re.sub(r'_V\d+$', '', subject_part).strip() # Strip out legacy duplicates notation

        # Determine the clean subject key
        json_subject = SUBJECT_MAP.get(subject_part, subject_part.title())
        if json_subject not in SUBJECT_LIST:
            # Fallback if text mismatch occurs
            matching_sub = [s for s in SUBJECT_LIST if s.upper() in subject_part.upper()]
            json_subject = matching_sub[0] if matching_sub else json_subject

        # Map exam tag to your specific structural layout block names
        json_exam = EXAM_MAP.get(exam_tag, exam_tag)

        # Initialize deep dictionary branches safely
        if year_string not in nested_structure:
            nested_structure[year_string] = {}
        if class_string not in nested_structure[year_string]:
            # Generate blank template populated with hash fallbacks
            nested_structure[year_string][class_string] = {
                "MT 1": {s: "#" for s in SUBJECT_LIST},
                "MT 2": {s: "#" for s in SUBJECT_LIST},
                "HY": {s: "#" for s in SUBJECT_LIST},
                "FT": {s: "#" for s in SUBJECT_LIST}
            }

        # Inject relative path location into correct slot
        if json_exam in nested_structure[year_string][class_string]:
            if json_subject in nested_structure[year_string][class_string][json_exam]:
                nested_structure[year_string][class_string][json_exam][json_subject] = f"documents/{file}"

    # Print out the final cleanly formatted text
    print(json.dumps(nested_structure, indent=4))

if __name__ == "__main__":
    import re
    generate_json_index()