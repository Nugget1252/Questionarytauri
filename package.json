{
  "name": "questionary",
  "version": "1.0.2",
  "description": "Questionary Desktop Study App",
  "main": "main.js",
  "author": "Questionary",
  "scripts": {
    "start": "electron .",
    "build:linux": "electron-builder --linux AppImage deb rpm",
    "build:appimage": "electron-builder --linux AppImage",
    "build:rpm": "electron-builder --linux --dir && node build-rpm.js",
    "build:deb": "electron-builder --linux deb",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac",
    "build:all": "electron-builder -wml",
    "android:sync": "cap sync android",
    "android:build": "cap sync android && cd android && ./gradlew assembleRelease"
  },
  "dependencies": {
    "@capacitor/android": "^6.0.0",
    "@capacitor/cli": "^6.0.0",
    "@capacitor/core": "^6.0.0",
    "sql.js": "^1.8.0"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "optionalDependencies": {
    "electron-installer-redhat": "^4.0.0",
    "electron-installer-debian": "^3.2.0"
  },
  "build": {
    "appId": "com.questionary.app",
    "productName": "Questionary",
    "executableName": "questionary",
    "asar": true,
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "index.html",
      "pdfviewer.html",
      "main.js",
      "preload.js",
      "questionary.db",
      "package.json",
      "assets/**/*",
      "css/**/*",
      "js/**/*",
      "node_modules/sql.js/**/*"
    ],
    "icon": "build/icon.png",
    "linux": {
      "target": [
        "AppImage",
        "deb",
        "rpm"
      ],
      "category": "Education",
      "maintainer": "Questionary <support@questionary.app>",
      "icon": "build/icons",
      "desktop": {
        "Name": "Questionary",
        "StartupWMClass": "questionary",
        "Comment": "Questionary Desktop Study App"
      }
    },
    "deb": {
      "priority": "optional",
      "packageCategory": "education"
    },
    "rpm": {
      "fpm": [
        "--rpm-compression",
        "xz",
        "--rpm-auto-add-directories",
        "--rpm-rpmbuild-define",
        "_build_id_links none",
        "--rpm-rpmbuild-define",
        "debug_package %{nil}",
        "--rpm-rpmbuild-define",
        "__spec_install_post %{nil}",
        "--rpm-rpmbuild-define",
        "__os_install_post %{nil}"
      ]
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "build/icon.png",
      "category": "public.app-category.education",
      "identity": null
    },
    "dmg": {
      "sign": false,
      "writeUpdateInfo": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Questionary"
    }
  }
}