{
  "name": "questionary",
  "version": "0.9.8",
  "description": "Questionary Desktop Study App",
  "main": "main.js",
  "author": "Questionary",
  "scripts": {
    "start": "electron .",
    "build:linux": "electron-builder --linux AppImage deb rpm",
    "build:appimage": "electron-builder --linux AppImage",
    "build:rpm": "electron-builder --linux rpm",
    "build:deb": "electron-builder --linux deb",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac",
    "build:all": "electron-builder -wml"
  },
  "dependencies": {
    "sql.js": "^1.8.0"
  },
  "devDependencies": {
    "electron": "^29.1.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.questionary.app",
    "productName": "Questionary",
    "executableName": "questionary",
    "asar": true,
    "files": [
      "index.html",
      "pdfviewer.html",
      "main.js",
      "preload.js",
      "questionary.db",
      "package.json",
      "assets/**/*",
      "css/**/*",
      "js/**/*",
      "node_modules/sql.js/**/*"
    ],
    "directories": {
      "output": "dist"
    },
    "linux": {
      "target": ["AppImage", "deb", "rpm"],
      "category": "Education",
      "maintainer": "Questionary <support@questionary.app>",
      "icon": "assets/icons",
      "desktop": {
        "StartupWMClass": "questionary",
        "Icon": "questionary"
      }
    },
    "deb": {
      "priority": "optional",
      "packageCategory": "education"
    },
    "rpm": {
      "fpm": [
        "--rpm-compression", "xz",
        "--rpm-auto-add-directories",
        "--rpm-rpmbuild-define", "_build_id_links none",
        "--rpm-rpmbuild-define", "debug_package %{nil}",
        "--rpm-rpmbuild-define", "__spec_install_post %{nil}",
        "--rpm-rpmbuild-define", "__os_install_post %{nil}"
      ]
    },
    "win": {
      "target": [
        { "target": "nsis", "arch": ["x64"] },
        { "target": "portable", "arch": ["x64"] }
      ],
      "icon": "assets/icons/512x512.png"
    },
    "mac": {
      "target": ["dmg", "zip"],
      "icon": "assets/icons/512x512.png",
      "category": "public.app-category.education"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Questionary"
    }
  }
}