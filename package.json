{
  "name": "questionary",
  "version": "0.9.8",
  "description": "Questionary Desktop Study App",
  "main": "main.js",
  "author": "Your Organization",
  "scripts": {
    "start": "electron .",
    "build:linux": "electron-builder --linux",
    "build:appimage": "electron-builder --linux AppImage",
    "build:rpm": "electron-builder --linux rpm",
    "build:deb": "electron-builder --linux deb",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac"
  },
  "dependencies": {
    "sql.js": "^1.8.0"
  },
  "devDependencies": {
    "electron": "^29.1.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.questionary.app",
    "productName": "Questionary",
    "files": [
      "**/*",
      "!dist/**",
      "!src-tauri/**",
      "!.git/**",
      "!.github/**",
      "!*.md",
      "!*.log"
    ],
    "directories": {
      "output": "dist"
    },
    "linux": {
      "target": ["AppImage", "rpm", "deb"],
      "icon": "assets/logo.png",
      "category": "Education",
      "maintainer": "Your Name <you@example.com>",
      "synopsis": "Questionary Desktop Study & Practice Companion"
    },
    "win": {
      "target": ["nsis", "portable"],
      "icon": "assets/logo.png"
    },
    "mac": {
      "target": ["dmg", "zip"],
      "icon": "assets/logo.png",
      "category": "public.app-category.education"
    }
  }
}
